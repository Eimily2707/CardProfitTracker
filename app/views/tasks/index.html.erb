<% content_for :title, t(".title") %>

<div class="w-full max-w-3xl mx-auto space-y-4">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>

  <% if notice %>
    <p class="rounded-md bg-green-50 px-4 py-2 text-sm text-green-800"><%= notice %></p>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".kind") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".priority") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".status") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @tasks.each do |task| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900"><%= I18n.t(task.kind, scope: "enums.task.kind") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= I18n.t(task.priority, scope: "enums.task.priority") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= I18n.t(task.status, scope: "enums.task.status") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm space-x-3">
              <% if policy(task).update? %>
                <% if task.status == "snoozed" %>
                  <%= button_to t(".unsnooze"), unsnooze_task_path(task), class: "text-gray-600 hover:text-gray-900 bg-transparent p-0 font-normal cursor-pointer inline" %>
                <% else %>
                  <%= button_to t(".snooze"), snooze_task_path(task), class: "text-gray-600 hover:text-gray-900 bg-transparent p-0 font-normal cursor-pointer inline" %>
                <% end %>
                <%= button_to t(".dismiss"), dismiss_task_path(task), form: { data: { turbo_confirm: true } }, class: "text-red-600 hover:text-red-900 bg-transparent p-0 font-normal cursor-pointer inline" %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @tasks.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-10 text-center text-sm text-gray-500"><%= t(".empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
