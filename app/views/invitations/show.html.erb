<% content_for :title, t(".title", account: @invitation.account.name) %>

<div class="w-full max-w-md mx-auto space-y-6">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title", account: @invitation.account.name) %></h1>


  <% if Current.user %>
    <p class="text-sm text-gray-600"><%= @invitation.email %></p>
    <%= button_to t(".submit"), accept_invitation_path(params[:token]), method: :post,
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% else %>
    <p class="text-sm text-gray-500"><%= t(".new_user_notice") %></p>

    <%= form_with url: accept_invitation_path(params[:token]), method: :post, class: "space-y-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700"><%= t(".email") %></label>
        <input type="text" value="<%= @invitation.email %>" disabled
               class="mt-1 block w-full rounded-md border-gray-200 bg-gray-50 text-gray-500 shadow-sm sm:text-sm">
      </div>

      <div>
        <%= label_tag "user_name", t(".name"), class: "block text-sm font-medium text-gray-700" %>
        <%= text_field_tag "user[name]", nil, required: true,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>

      <div>
        <%= label_tag "user_password", t(".password"), class: "block text-sm font-medium text-gray-700" %>
        <%= password_field_tag "user[password]", nil, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>

      <%= submit_tag t(".submit"),
          class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <% end %>

    <p class="text-sm text-gray-500">
      <%= t(".existing_user_notice") %>
      <%= link_to t(".sign_in_link"), new_session_path, class: "text-indigo-600 hover:text-indigo-900" %>
    </p>
  <% end %>
</div>
