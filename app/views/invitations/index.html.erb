<% content_for :title, t(".title") %>

<div class="w-full max-w-3xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>
    <%= link_to t("invitations.new.title"), new_invitation_path,
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>


  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".email") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".role") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".invited_by") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".expires_at") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @invitations.each do |invitation| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900"><%= invitation.email %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= I18n.t(invitation.role, scope: "enums.membership.role") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= invitation.invited_by&.name || invitation.invited_by&.email %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= l(invitation.expires_at, format: :short) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <%= button_to t(".revoke"), invitation_path(invitation), method: :delete,
                  form: { data: { turbo_confirm: true } }, class: "text-red-600 hover:text-red-900 bg-transparent p-0 font-normal cursor-pointer" %>
            </td>
          </tr>
        <% end %>

        <% if @invitations.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-10 text-center text-sm text-gray-500"><%= t(".empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
