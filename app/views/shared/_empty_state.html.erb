<%
  cta_text ||= nil
  cta_path ||= nil
  description ||= nil
%>
<div class="flex flex-col items-center justify-center gap-3 px-4 py-12 text-center">
  <svg class="h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.75h16.5M3.75 9.75v8.25A2.25 2.25 0 0 0 6 20.25h12a2.25 2.25 0 0 0 2.25-2.25V9.75M3.75 9.75l2.432-5.4A1.5 1.5 0 0 1 7.54 3.5h8.92a1.5 1.5 0 0 1 1.358.85l2.432 5.4M9 13.5h6" />
  </svg>
  <p class="text-sm font-medium text-gray-700"><%= title %></p>
  <% if description.present? %>
    <p class="max-w-xs text-sm text-gray-400"><%= description %></p>
  <% end %>
  <% if cta_text.present? && cta_path.present? %>
    <%= link_to cta_text, cta_path,
        class: "mt-1 inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</div>
