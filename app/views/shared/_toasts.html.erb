<div class="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex flex-col items-center gap-2 p-4 sm:items-end" aria-live="polite" aria-atomic="true">
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <div data-controller="toast"
         class="pointer-events-auto w-full max-w-sm rounded-md px-4 py-3 text-sm shadow-lg ring-1 transition-all duration-300 <%= type.to_s == "alert" ? "bg-red-50 text-red-800 ring-red-200" : "bg-green-50 text-green-800 ring-green-200" %>">
      <div class="flex items-start justify-between gap-3">
        <p><%= message %></p>
        <button type="button" data-action="toast#dismiss" class="shrink-0 cursor-pointer text-current opacity-60 hover:opacity-100" aria-label="<%= t("shared.dismiss") %>">
          &times;
        </button>
      </div>
    </div>
  <% end %>
</div>
