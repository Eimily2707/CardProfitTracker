<% content_for :title, t(".title") %>

<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <%= form_with url: registration_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= label_tag "user_name", t(".name"), class: "sr-only" %>
      <%= text_field_tag "user[name]", @user&.name, placeholder: t(".name"), required: true,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= label_tag "user_email", t(".email"), class: "sr-only" %>
      <%= email_field_tag "user[email]", @user&.email, placeholder: t(".email"), required: true, autocomplete: "username",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= label_tag "user_password", t(".password"), class: "sr-only" %>
      <%= password_field_tag "user[password]", nil, placeholder: t(".password"), required: true, autocomplete: "new-password", maxlength: 72,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= label_tag "account_name", t(".account_name"), class: "sr-only" %>
      <%= text_field_tag "account[name]", nil, placeholder: t(".account_name"), required: true,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= label_tag "account_country", t(".country"), class: "sr-only" %>
      <%= text_field_tag "account[country]", nil, placeholder: t(".country"), required: true, maxlength: 2, pattern: "[A-Za-z]{2}",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full uppercase" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit t(".submit"), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= t(".already_have_account") %>
        <%= link_to t(".sign_in_link"), new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
