<% content_for :title, t(".title") %>

<div class="w-full max-w-4xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>
    <%= link_to t("expenses.new.title"), new_expense_path,
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>

  <%= form_with url: expenses_path, method: :get, class: "grid gap-3 sm:grid-cols-4" do %>
    <div>
      <label class="sr-only" for="expense_category_id"><%= t(".category") %></label>
      <%= select_tag :expense_category_id, options_for_select(Current.account.expense_categories.order(:name).pluck(:name, :id), params[:expense_category_id]),
          include_blank: t(".category"), onchange: "this.form.requestSubmit()",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <label class="sr-only" for="channel_id"><%= t(".channel") %></label>
      <%= select_tag :channel_id, options_for_select(Current.account.channels.order(:name).pluck(:name, :id), params[:channel_id]),
          include_blank: t(".channel"), onchange: "this.form.requestSubmit()",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <label class="sr-only" for="status"><%= t(".status") %></label>
      <%= select_tag :status, options_for_select(Expense::STATUSES.map { |s| [ I18n.t(s, scope: "enums.expense.status"), s ] }, params[:status]),
          include_blank: t(".status"), onchange: "this.form.requestSubmit()",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div class="flex gap-2">
      <%= date_field_tag :from, params[:from], placeholder: t(".from"),
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <%= date_field_tag :to, params[:to], placeholder: t(".to"),
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".incurred_on") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".category") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".channel") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".status") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".amount") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @expenses.each do |expense| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900">
              <%= link_to l(expense.incurred_on, format: :short), expense_path(expense), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= expense.expense_category.name %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= expense.channel&.name %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm"><%= status_badge(expense.status, scope: "expense.status") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-700"><%= expense.amount.format %></td>
          </tr>
        <% end %>

        <% if @expenses.empty? %>
          <tr>
            <td colspan="5" class="px-0 py-0">
              <%= render "shared/empty_state", title: t(".empty"), cta_text: t("expenses.new.title"), cta_path: new_expense_path %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
