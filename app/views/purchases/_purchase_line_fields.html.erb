<div class="rounded-md border border-gray-200 p-3 space-y-3" data-nested-form-target="item">
  <div class="flex items-center justify-between">
    <span class="text-xs font-medium uppercase tracking-wide text-gray-400"><%= t("purchases.form.line") %></span>
    <button type="button" data-action="nested-form#remove" class="text-xs text-red-600 hover:text-red-900 cursor-pointer">
      <%= t("purchases.form.remove_line") %>
    </button>
  </div>

  <%= f.hidden_field :_destroy %>

  <div class="relative" data-controller="purchase-line-search" data-purchase-line-search-url-value="<%= catalog_search_path %>">
    <%= f.hidden_field :ct_blueprint_id, data: { purchase_line_search_target: "blueprintId" } %>

    <label class="block text-xs font-medium text-gray-500"><%= t("purchases.form.search_card") %></label>
    <input type="text" placeholder="<%= t("purchases.form.search_card") %>" autocomplete="off"
           data-purchase-line-search-target="query" data-action="input->purchase-line-search#search"
           class="mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
    <div data-purchase-line-search-target="results"
         class="absolute z-10 mt-1 hidden w-full max-h-56 overflow-y-auto rounded-md border border-gray-200 bg-white shadow-lg"></div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :description, t("purchases.form.description"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.text_field :description, required: true, data: { purchase_line_search_target: "description" },
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :expansion_name, t("purchases.form.expansion_name"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.text_field :expansion_name, data: { purchase_line_search_target: "expansionName" },
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :kind, t("purchases.form.kind"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.select :kind, PurchaseLine::KINDS.map { |kind| [ I18n.t(kind, scope: "enums.purchase_line.kind"), kind ] }, {},
          data: { purchase_line_search_target: "kind" },
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :intent, t("purchases.form.intent"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.select :intent, PurchaseLine::INTENTS.map { |intent| [ I18n.t(intent, scope: "enums.purchase_line.intent"), intent ] }, {},
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :quantity, t("purchases.form.quantity"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.number_field :quantity, min: 1, required: true, data: { purchase_totals_target: "quantity", action: "input->purchase-totals#recompute" },
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :unit_price, t("purchases.form.unit_price"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.text_field :unit_price, required: true, inputmode: "decimal",
          data: { purchase_totals_target: "unitPrice", action: "input->purchase-totals#recompute" },
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-3">
    <div>
      <%= f.label "properties_condition", t("purchases.form.condition"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.select "properties[condition]", PurchaseLine::CONDITIONS.map { |c| [ I18n.t(c, scope: "enums.condition"), c ] },
          { include_blank: true, selected: f.object.properties["condition"] },
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label "properties_language", t("purchases.form.language"), class: "block text-xs font-medium text-gray-500" %>
      <%= f.text_field "properties[language]", value: f.object.properties["language"],
          class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div class="flex items-end pb-2 gap-2">
      <%= check_box_tag "#{f.object_name}[properties][foil]", "1", ActiveModel::Type::Boolean.new.cast(f.object.properties["foil"]),
          class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <%= label_tag "#{f.object_name}_properties_foil", t("purchases.form.foil"), class: "text-xs font-medium text-gray-500" %>
    </div>
  </div>
</div>
