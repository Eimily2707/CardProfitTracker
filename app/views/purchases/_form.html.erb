<%= form_with model: purchase, class: "space-y-6" do |f| %>
  <% if purchase.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-medium">Correggi i seguenti errori:</p>
      <ul class="mt-1 list-disc list-inside">
        <% purchase.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div data-controller="purchase-intent" class="rounded-md border border-gray-200 p-4">
    <p class="text-sm font-medium text-gray-700">Strategia prodotto</p>

    <div class="mt-3 space-y-3">
      <label class="flex items-start gap-3">
        <%= f.radio_button :intent_type, "keep_sealed",
            data: { action: "change->purchase-intent#toggle" },
            class: "mt-1 h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <span>
          <span class="block text-sm font-medium text-gray-900">&#128230; Mantieni Sigillato (Keep Sealed)</span>
          <span class="block text-sm text-gray-500">Il box entra direttamente in inventario come oggetto unico.</span>
        </span>
      </label>

      <label class="flex items-start gap-3">
        <%= f.radio_button :intent_type, "crack_and_sell",
            data: { action: "change->purchase-intent#toggle" },
            class: "mt-1 h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <span>
          <span class="block text-sm font-medium text-gray-900">&#9986;&#65039; Spacchetta e Vendi (Crack &amp; Sell)</span>
          <span class="block text-sm text-gray-500">Il box verr&agrave; aperto per inserire le singole carte estratte.</span>
        </span>
      </label>
    </div>

    <div data-purchase-intent-target="sealedSection" hidden
         data-controller="cardtrader-search"
         data-cardtrader-search-url-value="<%= cardtrader_search_path %>"
         class="mt-4 space-y-3 border-t border-gray-100 pt-4">
      <p class="text-sm text-gray-500">Cerca il prodotto sigillato nel catalogo CardTrader per collegarlo (facoltativo).</p>

      <div class="relative">
        <input type="text" autocomplete="off" placeholder="Cerca box/prodotto sigillato..."
               data-cardtrader-search-target="query" data-action="input->cardtrader-search#search"
               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">

        <div data-cardtrader-search-target="results"
             class="hidden absolute z-10 mt-1 max-h-64 w-full overflow-auto rounded-md border border-gray-200 bg-white shadow-lg"></div>
      </div>

      <div data-cardtrader-search-target="preview" class="hidden flex items-center gap-3 rounded-md border border-gray-100 bg-gray-50 p-3">
        <img data-cardtrader-search-target="previewImage" src="" alt="" class="h-12 w-12 rounded object-contain bg-white">
        <div>
          <p data-cardtrader-search-target="previewName" class="text-sm font-medium text-gray-900"></p>
          <p data-cardtrader-search-target="previewSet" class="text-xs text-gray-500"></p>
        </div>
      </div>

      <%= f.hidden_field :cardtrader_blueprint_id, value: purchase.cardtrader_blueprint_id, data: { cardtrader_search_target: "blueprintId" } %>
      <%= f.hidden_field :category_id, value: purchase.category_id, data: { cardtrader_search_target: "categoryId" } %>
      <%= f.hidden_field :blueprint_image_url, value: purchase.blueprint_image_url, data: { cardtrader_search_target: "imageUrl" } %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, placeholder: "Booster Box Ravnica", required: true,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :source, "Fonte", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :source, Purchase::SOURCES, { include_blank: "Seleziona una fonte" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :product_type, "Tipo prodotto", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :product_type, Purchase::PRODUCT_TYPES, { include_blank: "Seleziona un tipo" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :purchase_date, "Data acquisto", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :purchase_date,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :cardtrader_order_id, "ID ordine CardTrader", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :cardtrader_order_id,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :total_price, "Costo totale (€)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :total_price, step: 0.01, min: 0, placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :shipping_cost, "Costo spedizione (€)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :shipping_cost, step: 0.01, min: 0, placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :tax, "Tasse / dazi (€)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :tax, step: 0.01, min: 0, placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div class="flex items-center pt-6">
      <%= f.check_box :via_cardtrader_zero, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <%= f.label :via_cardtrader_zero, "Acquistato tramite CardTrader Zero", class: "ml-2 block text-sm text-gray-700" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :notes, "Note", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :notes, rows: 3,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit purchase.new_record? ? "Registra acquisto" : "Salva modifiche",
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Annulla", purchase.new_record? ? purchases_path : purchase_path(purchase),
        class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
