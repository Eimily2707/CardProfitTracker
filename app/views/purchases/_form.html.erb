<%= form_with model: purchase, class: "space-y-6", data: { controller: "purchase-totals" } do |f| %>
  <% if purchase.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% purchase.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :channel_id, t("purchases.form.channel"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :channel_id, Current.account.channels.active.order(:name), :id, :name, { include_blank: true },
          required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :title, t("purchases.form.title"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :title, required: true,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :seller_ref, t("purchases.form.seller_ref"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :seller_ref,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :ordered_at, t("purchases.form.ordered_at"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :ordered_at,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :currency, t("purchases.form.currency"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :currency, maxlength: 3,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm uppercase" %>
    </div>

    <div>
      <%= f.label :fx_rate, t("purchases.form.fx_rate"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :fx_rate, inputmode: "decimal", placeholder: t("purchases.form.fx_rate_hint", currency: Current.account.base_currency),
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, t("purchases.form.notes"), class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :notes, rows: 2,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div data-controller="nested-form" class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("purchases.form.lines") %></h2>
      <button type="button" data-action="nested-form#add" class="text-sm text-indigo-600 hover:text-indigo-900 cursor-pointer">
        <%= t("purchases.form.add_line") %>
      </button>
    </div>

    <div data-nested-form-target="container" class="space-y-3">
      <%= f.fields_for :purchase_lines do |line_form| %>
        <%= render "purchase_line_fields", f: line_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :purchase_lines, PurchaseLine.new, child_index: "NEW_RECORD" do |line_form| %>
        <%= render "purchase_line_fields", f: line_form %>
      <% end %>
    </template>
  </div>

  <div data-controller="nested-form" class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("purchases.form.charges") %></h2>
      <button type="button" data-action="nested-form#add" class="text-sm text-indigo-600 hover:text-indigo-900 cursor-pointer">
        <%= t("purchases.form.add_charge") %>
      </button>
    </div>

    <div data-nested-form-target="container" class="space-y-3">
      <%= f.fields_for :purchase_charges do |charge_form| %>
        <%= render "purchase_charge_fields", f: charge_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :purchase_charges, PurchaseCharge.new, child_index: "NEW_RECORD" do |charge_form| %>
        <%= render "purchase_charge_fields", f: charge_form %>
      <% end %>
    </template>
  </div>

  <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm space-y-1">
    <p class="flex justify-between"><span><%= t("purchases.form.preview_subtotal") %></span> <span data-purchase-totals-target="subtotal">-</span></p>
    <p class="flex justify-between"><span><%= t("purchases.form.preview_charges") %></span> <span data-purchase-totals-target="chargesTotal">-</span></p>
    <p class="flex justify-between font-semibold"><span><%= t("purchases.form.preview_total") %></span> <span data-purchase-totals-target="total">-</span></p>
  </div>

  <%= f.submit t("purchases.form.submit"), data: { turbo_submits_with: t("shared.processing") },
      class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
<% end %>
