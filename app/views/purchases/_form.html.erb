<%= form_with model: purchase, class: "space-y-6" do |f| %>
  <% if purchase.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-medium">Correggi i seguenti errori:</p>
      <ul class="mt-1 list-disc list-inside">
        <% purchase.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, placeholder: "Booster Box Ravnica", required: true,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :source, "Fonte", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :source, Purchase::SOURCES, { include_blank: "Seleziona una fonte" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :product_type, "Tipo prodotto", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :product_type, Purchase::PRODUCT_TYPES, { include_blank: "Seleziona un tipo" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :purchase_date, "Data acquisto", class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :purchase_date,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :cardtrader_order_id, "ID ordine CardTrader", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :cardtrader_order_id,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :total_price, "Costo totale (€)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :total_price, step: 0.01, min: 0, placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :shipping_cost, "Costo spedizione (€)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :shipping_cost, step: 0.01, min: 0, placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :tax, "Tasse / dazi (€)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :tax, step: 0.01, min: 0, placeholder: "0.00",
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div class="flex items-center pt-6">
      <%= f.check_box :via_cardtrader_zero, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
      <%= f.label :via_cardtrader_zero, "Acquistato tramite CardTrader Zero", class: "ml-2 block text-sm text-gray-700" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :notes, "Note", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :notes, rows: 3,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit purchase.new_record? ? "Registra acquisto" : "Salva modifiche",
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Annulla", purchase.new_record? ? purchases_path : purchase_path(purchase),
        class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
