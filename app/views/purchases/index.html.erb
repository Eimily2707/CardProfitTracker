<% content_for :title, "Acquisti" %>

<div class="w-full max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Acquisti</h1>
    <%= link_to "Nuovo acquisto", new_purchase_path,
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>

  <% if notice %>
    <p class="mb-4 rounded-md bg-green-50 px-4 py-2 text-sm text-green-800"><%= notice %></p>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Data</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Nome</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Fonte</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Tipo prodotto</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Costo totale</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Spedizione</th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Azioni</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @purchases.each do |purchase| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= purchase.purchase_date&.strftime("%d/%m/%Y") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= purchase.name %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= source_badge_classes(purchase.source) %>">
                <%= purchase.source %>
              </span>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= purchase.product_type %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-900"><%= format_money(purchase.total_price_cents, currency: purchase.currency) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-700"><%= format_money(purchase.shipping_cost_cents, currency: purchase.currency) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <%= link_to "Dettaglio", purchase_path(purchase), class: "text-indigo-600 hover:text-indigo-900" %>
              <%= link_to "Elimina", purchase_path(purchase), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Eliminare questo acquisto e tutti i riferimenti alle carte collegate?"
                  }, class: "ml-3 text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>

        <% if @purchases.empty? %>
          <tr>
            <td colspan="7" class="px-4 py-10 text-center text-sm text-gray-500">Nessun acquisto registrato.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
