<% content_for :title, t(".title") %>

<div class="w-full max-w-4xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>
    <%= link_to t("purchases.new.title"), new_purchase_path,
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>

  <% if notice %>
    <p class="rounded-md bg-green-50 px-4 py-2 text-sm text-green-800"><%= notice %></p>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".title_column") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".channel") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".status") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".total") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @purchases.each do |purchase| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900">
              <%= link_to purchase.title, purchase_path(purchase), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= purchase.channel.name %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= I18n.t(purchase.status, scope: "enums.purchase.status") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= purchase.total.format %></td>
          </tr>
        <% end %>

        <% if @purchases.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-10 text-center text-sm text-gray-500"><%= t(".empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
