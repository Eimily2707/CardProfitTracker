<div class="rounded-md border border-gray-200 p-3 flex items-end gap-3" data-nested-form-target="item">
  <%= f.hidden_field :_destroy %>

  <div class="flex-1">
    <%= f.label :kind, t("purchases.form.charge_kind"), class: "block text-xs font-medium text-gray-500" %>
    <%= f.select :kind, PurchaseCharge::KINDS.map { |kind| [ I18n.t(kind, scope: "enums.purchase_charge.kind"), kind ] }, {},
        data: { action: "change->purchase-totals#recompute" },
        class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="flex-1">
    <%= f.label :amount, t("purchases.form.charge_amount"), class: "block text-xs font-medium text-gray-500" %>
    <%= f.text_field :amount, inputmode: "decimal", data: { purchase_totals_target: "chargeAmount", action: "input->purchase-totals#recompute" },
        class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <button type="button" data-action="nested-form#remove" class="text-xs text-red-600 hover:text-red-900 cursor-pointer pb-2">
    <%= t("purchases.form.remove_charge") %>
  </button>
</div>
