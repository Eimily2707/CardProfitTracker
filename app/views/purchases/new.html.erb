<% content_for :title, "Nuovo acquisto" %>

<div class="w-full max-w-2xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Nuovo acquisto</h1>
    <%= link_to "Importa da CardTrader", import_from_cardtrader_purchases_path,
        class: "text-sm font-medium text-indigo-600 hover:text-indigo-900" %>
  </div>

  <% if alert %>
    <p class="mb-4 rounded-md bg-red-50 px-4 py-2 text-sm text-red-800"><%= alert %></p>
  <% end %>

  <%= render "form", purchase: @purchase %>
</div>
