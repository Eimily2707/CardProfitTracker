<% content_for :title, "Importa da CardTrader" %>

<div class="w-full max-w-3xl mx-auto space-y-6">
  <div>
    <%= link_to "← Nuovo acquisto", new_purchase_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="mt-2 text-2xl font-semibold text-gray-900">Importa da CardTrader</h1>
    <p class="mt-1 text-sm text-gray-500">Scegli un ordine dalla lista, oppure inserisci direttamente il suo ID.</p>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-medium text-gray-700">Inserisci un ID ordine</h2>
    <%= form_with url: import_from_cardtrader_purchases_path, method: :get, class: "mt-3 flex gap-3" do %>
      <%= text_field_tag :order_id, params[:order_id], placeholder: "Es. 123456",
          class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <%= submit_tag "Importa",
          class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <% end %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
    <h2 class="px-6 pt-6 text-sm font-medium text-gray-700">Ultimi ordini</h2>

    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Ordine</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Stato</th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Articoli</th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Totale</th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recent_orders.each do |order| %>
            <tr>
              <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900">#<%= order["id"] %></td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= order["state"] %></td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= order["size"] %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-900">
                <%= format_money(order.dig("buyer_total", "cents"), currency: order.dig("buyer_total", "currency") || "EUR") %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
                <%= link_to "Importa", import_from_cardtrader_purchases_path(order_id: order["id"]),
                    class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>

          <% if @recent_orders.empty? %>
            <tr>
              <td colspan="5" class="px-4 py-10 text-center text-sm text-gray-500">Nessun ordine trovato su CardTrader.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
