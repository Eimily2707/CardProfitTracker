<% content_for :title, @purchase.title %>

<div class="w-full max-w-3xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900"><%= @purchase.title %></h1>
      <p class="mt-1 flex items-center gap-2 text-sm text-gray-500">
        <%= @purchase.channel.name %>
        <%= status_badge(@purchase.status, scope: "purchase.status") %>
      </p>
    </div>

    <div class="flex gap-2">
      <% if policy(@purchase).update? %>
        <%= link_to t(".edit"), edit_purchase_path(@purchase), class: "rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
      <% end %>

      <% if policy(@purchase).transition? && @purchase.status == "draft" %>
        <%= button_to t(".confirm"), confirm_purchase_path(@purchase), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm text-white hover:bg-indigo-500 cursor-pointer" %>
        <%= button_to t(".confirm_received"), confirm_received_purchase_path(@purchase), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm text-white hover:bg-indigo-500 cursor-pointer" %>
      <% end %>

      <% if policy(@purchase).transition? && @purchase.status == "ordered" %>
        <%= button_to t(".receive"), receive_purchase_path(@purchase), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm text-white hover:bg-indigo-500 cursor-pointer" %>
        <%= button_to t(".cancel"), cancel_purchase_path(@purchase), form: { data: { turbo_confirm: true } }, class: "rounded-md border border-red-300 px-3 py-2 text-sm text-red-700 hover:bg-red-50 cursor-pointer" %>
      <% end %>

      <% if policy(@purchase).destroy? %>
        <%= button_to t(".destroy"), purchase_path(@purchase), method: :delete, form: { data: { turbo_confirm: true } }, class: "rounded-md border border-red-300 px-3 py-2 text-sm text-red-700 hover:bg-red-50 cursor-pointer" %>
      <% end %>

      <% if Current.membership&.admin? || Current.membership&.owner? %>
        <%= link_to t(".audit_log"), audit_log_path(type: "Purchase", id: @purchase.id), class: "rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm space-y-1 text-sm">
    <p class="flex justify-between"><span><%= t(".subtotal") %></span> <span><%= @purchase.subtotal.format %></span></p>
    <p class="flex justify-between"><span><%= t(".charges_total") %></span> <span><%= @purchase.charges_total.format %></span></p>
    <p class="flex justify-between font-semibold"><span><%= t(".total") %></span> <span><%= @purchase.total.format %></span></p>
    <% if @purchase.total_base_cents.present? %>
      <p class="flex justify-between text-gray-500"><span><%= t(".total_base") %></span> <span><%= @purchase.total_base.format %></span></p>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".line_description") %></th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".line_quantity") %></th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".line_unit_price") %></th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".line_total") %></th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".line_items") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @purchase.purchase_lines.each do |line| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-900"><%= line.description %></td>
            <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-700"><%= line.quantity %></td>
            <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-700"><%= line.unit_price.format %></td>
            <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-700"><%= line.line_total.format %></td>
            <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-700"><%= line.inventory_items.size %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @purchase.purchase_charges.any? %>
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".charge_kind") %></th>
            <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".charge_amount") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @purchase.purchase_charges.each do |charge| %>
            <tr>
              <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-900"><%= I18n.t(charge.kind, scope: "enums.purchase_charge.kind") %></td>
              <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-700"><%= charge.amount.format %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
