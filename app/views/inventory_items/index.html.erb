<% content_for :title, t(".title") %>

<div class="w-full max-w-5xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>
    <%= link_to t(".export_csv"), inventory_items_path(request.query_parameters.merge(format: :csv)),
        class: "text-sm text-indigo-600 hover:text-indigo-900" %>
  </div>

  <% if notice %>
    <p class="rounded-md bg-green-50 px-4 py-2 text-sm text-green-800"><%= notice %></p>
  <% end %>
  <% if alert %>
    <p class="rounded-md bg-red-50 px-4 py-2 text-sm text-red-800"><%= alert %></p>
  <% end %>

  <%= form_with url: inventory_items_path, method: :get, class: "grid gap-3 sm:grid-cols-3 lg:grid-cols-6" do %>
    <div class="lg:col-span-2">
      <label class="sr-only" for="q"><%= t(".search") %></label>
      <%= text_field_tag :q, params[:q], placeholder: t(".search"),
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= select_tag :kind, options_for_select(InventoryItem::KINDS.map { |k| [ I18n.t(k, scope: "enums.purchase_line.kind"), k ] }, params[:kind]),
          include_blank: t(".kind"), onchange: "this.form.requestSubmit()",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= select_tag :status, options_for_select(InventoryItem::STATUSES.map { |s| [ I18n.t(s, scope: "enums.inventory_item.status"), s ] }, params[:status]),
          include_blank: t(".status"), onchange: "this.form.requestSubmit()",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= text_field_tag :location, params[:location], placeholder: t(".location"),
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div class="flex gap-2">
      <%= date_field_tag :from, params[:from], placeholder: t(".from"),
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <%= date_field_tag :to, params[:to], placeholder: t(".to"),
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div class="flex gap-2">
      <%= number_field_tag :cost_min, params[:cost_min], placeholder: t(".cost_min"), step: "0.01",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <%= number_field_tag :cost_max, params[:cost_max], placeholder: t(".cost_max"), step: "0.01",
          class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div class="lg:col-span-6">
      <%= submit_tag t(".apply"), class: "rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer" %>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".name") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".kind") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".status") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".location") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".acquired_on") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".cost") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @items.each do |item| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900">
              <%= link_to item.name, inventory_item_path(item), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= I18n.t(item.kind, scope: "enums.purchase_line.kind") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= I18n.t(item.status, scope: "enums.inventory_item.status") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= item.location %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= l(item.acquired_on, format: :short) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-700"><%= item.cost_base.format %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <% if policy(item).open? && item.status == "in_stock" && item.kind.in?(%w[sealed bulk_lot]) %>
                <%= button_to t(".open"), open_inventory_item_path(item), class: "rounded-md border border-gray-300 px-2 py-1 text-xs text-gray-700 hover:bg-gray-50 cursor-pointer" %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @items.empty? %>
          <tr>
            <td colspan="7" class="px-4 py-10 text-center text-sm text-gray-500"><%= t(".empty") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex items-center justify-between text-sm text-gray-500">
    <span><%= t(".total_count", count: @total_count) %></span>
    <div class="flex gap-2">
      <% if @page > 1 %>
        <%= link_to t(".previous"), inventory_items_path(request.query_parameters.merge(page: @page - 1)),
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
      <% end %>
      <% if @page * InventoryItemsController::PER_PAGE < @total_count %>
        <%= link_to t(".next"), inventory_items_path(request.query_parameters.merge(page: @page + 1)),
            class: "rounded-md border border-gray-300 px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
      <% end %>
    </div>
  </div>
</div>
