<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Card Profit Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if Current.user %>
      <header class="border-b border-gray-200 bg-white" data-controller="mobile-menu">
        <div class="container mx-auto flex items-center justify-between gap-4 px-5 py-3">
          <div class="flex min-w-0 items-center gap-3">
            <%= link_to t("app.name"), root_path, class: "shrink-0 text-sm font-semibold text-gray-900" %>
            <%= render "shared/account_switcher" %>
          </div>

          <nav class="hidden items-center gap-4 sm:flex" aria-label="<%= t("app.name") %>">
            <%= render "shared/nav_links" %>
            <%= render "shared/locale_switcher" %>
            <%= button_to t("dashboard.sign_out"), session_path, method: :delete, class: "text-sm text-red-600 hover:text-red-900 cursor-pointer" %>
          </nav>

          <button type="button" class="inline-flex items-center justify-center rounded-md p-2 text-gray-600 hover:bg-gray-100 sm:hidden"
                  data-action="mobile-menu#toggle" aria-controls="mobile-nav-panel" aria-expanded="false"
                  aria-label="<%= t("layouts.menu_toggle") %>">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>

        <nav id="mobile-nav-panel" data-mobile-menu-target="panel" hidden
             data-action="keydown.esc@window->mobile-menu#closeOnEscape"
             class="flex flex-col gap-1 border-t border-gray-200 px-5 py-3 sm:hidden"
             aria-label="<%= t("app.name") %>">
          <%= render "shared/nav_links", link_class: "block rounded-md px-2 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
          <div class="mt-2 flex items-center justify-between border-t border-gray-100 pt-2">
            <%= render "shared/locale_switcher" %>
            <%= button_to t("dashboard.sign_out"), session_path, method: :delete, class: "text-sm text-red-600 hover:text-red-900 cursor-pointer" %>
          </div>
        </nav>
      </header>
    <% end %>

    <%= render "shared/toasts" %>

    <main class="container mx-auto mt-16 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
