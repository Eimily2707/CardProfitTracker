<%= form_with model: expense_category, class: "space-y-4" do |f| %>
  <% if expense_category.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% expense_category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("expense_categories.name"), class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, required: true,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
    <%= f.label :active, t("expense_categories.active"), class: "text-sm font-medium text-gray-700" %>
  </div>

  <%= f.submit t("expense_categories.submit"),
      class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
<% end %>
