<% content_for :title, t(".title") %>

<div class="w-full max-w-3xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>
    <%= link_to t("expense_categories.new.title"), new_expense_category_path,
        class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".name") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"><%= t(".active") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @expense_categories.each do |category| %>
          <tr>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900">
              <%= category.name %>
              <% if category.system? %>
                <span class="ml-1 rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-500"><%= t(".system_badge") %></span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-700"><%= category.active? ? t(".yes") : t(".no") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm space-x-3">
              <%= link_to t(".edit"), edit_expense_category_path(category), class: "text-indigo-600 hover:text-indigo-900" %>
              <% unless category.system? %>
                <%= button_to t(".destroy"), expense_category_path(category), method: :delete,
                    form: { data: { turbo_confirm: true }, class: "inline-block" },
                    class: "text-red-600 hover:text-red-900 bg-transparent p-0 font-normal cursor-pointer" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
