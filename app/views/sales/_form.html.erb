<%= form_with model: sale_order, url: sale_order.persisted? ? sale_path(sale_order) : sales_path, class: "space-y-6", data: { controller: "sale-totals" } do |f| %>
  <% if sale_order.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% sale_order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :channel_id, t("sales.form.channel"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :channel_id, Current.account.channels.active.where(usage: %w[sale both]).order(:name), :id, :name, { include_blank: true },
          required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :buyer_ref, t("sales.form.buyer_ref"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :buyer_ref,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :sold_at, t("sales.form.sold_at"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :sold_at,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :currency, t("sales.form.currency"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :currency, maxlength: 3,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm uppercase" %>
    </div>

    <div>
      <%= f.label :fx_rate, t("sales.form.fx_rate"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :fx_rate, inputmode: "decimal", placeholder: t("sales.form.fx_rate_hint", currency: Current.account.base_currency),
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= f.label :payment_method, t("sales.form.payment_method"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :payment_method, SaleOrder::PAYMENT_METHODS.map { |method| [ I18n.t(method, scope: "enums.sale_order.payment_method"), method ] }, { include_blank: true },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, t("sales.form.notes"), class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :notes, rows: 2,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div data-controller="nested-form" class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.form.lines") %></h2>
      <button type="button" data-action="nested-form#add" class="text-sm text-indigo-600 hover:text-indigo-900 cursor-pointer">
        <%= t("sales.form.add_line") %>
      </button>
    </div>

    <div data-nested-form-target="container" class="space-y-3">
      <%= f.fields_for :sale_lines do |line_form| %>
        <%= render "sale_line_fields", f: line_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :sale_lines, SaleLine.new, child_index: "NEW_RECORD" do |line_form| %>
        <%= render "sale_line_fields", f: line_form %>
      <% end %>
    </template>
  </div>

  <div data-controller="nested-form" class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-900"><%= t("sales.form.charges") %></h2>
      <button type="button" data-action="nested-form#add" class="text-sm text-indigo-600 hover:text-indigo-900 cursor-pointer">
        <%= t("sales.form.add_charge") %>
      </button>
    </div>

    <div data-nested-form-target="container" class="space-y-3">
      <%= f.fields_for :sale_charges do |charge_form| %>
        <%= render "sale_charge_fields", f: charge_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :sale_charges, SaleCharge.new, child_index: "NEW_RECORD" do |charge_form| %>
        <%= render "sale_charge_fields", f: charge_form %>
      <% end %>
    </template>
  </div>

  <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm space-y-1">
    <p class="flex justify-between"><span><%= t("sales.form.preview_subtotal") %></span> <span data-sale-totals-target="subtotal">-</span></p>
    <p class="flex justify-between"><span><%= t("sales.form.preview_charges") %></span> <span data-sale-totals-target="chargesTotal">-</span></p>
    <p class="flex justify-between font-semibold"><span><%= t("sales.form.preview_total") %></span> <span data-sale-totals-target="total">-</span></p>
  </div>

  <%= f.submit t("sales.form.submit"), data: { turbo_submits_with: t("shared.processing") },
      class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
<% end %>
