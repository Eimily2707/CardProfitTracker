<div class="rounded-md border border-gray-200 p-3 flex flex-wrap items-end gap-3" data-nested-form-target="item">
  <%= f.hidden_field :_destroy %>

  <div class="min-w-[8rem] flex-1">
    <%= f.label :kind, t("sales.form.charge_kind"), class: "block text-xs font-medium text-gray-500" %>
    <%= f.select :kind,
        options_for_select(SaleCharge::KINDS.map { |kind| [ I18n.t(kind, scope: "enums.sale_charge.kind"), kind, { data: { direction: SaleCharge::KIND_DIRECTIONS[kind] } } ] }, f.object.kind),
        {}, data: { sale_totals_target: "chargeKind", action: "change->sale-totals#recompute" },
        class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="min-w-[6rem] flex-1">
    <%= f.label :amount, t("sales.form.charge_amount"), class: "block text-xs font-medium text-gray-500" %>
    <%= f.text_field :amount, inputmode: "decimal", data: { sale_totals_target: "chargeAmount", action: "input->sale-totals#recompute" },
        class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <button type="button" data-action="nested-form#remove" class="text-xs text-red-600 hover:text-red-900 cursor-pointer pb-2">
    <%= t("sales.form.remove_charge") %>
  </button>
</div>
